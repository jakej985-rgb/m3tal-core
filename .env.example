# --- Web GUI & API ---
# Port for the embedded M3TAL Web GUI and REST API
API_PORT=5050

# --- Auth ---
# Bearer/X-API-Token credential for API and plugin access
API_TOKEN=

# --- TLS (optional) ---
# Serve the API over HTTPS directly. Both must be set together; when unset,
# Core serves plaintext HTTP and logs a warning (use a TLS-terminating
# reverse proxy instead if you terminate TLS upstream).
# M3TAL_TLS_CERT=
# M3TAL_TLS_KEY=

# --- State ---
# Optional SQLite state path (defaults to /var/lib/m3tal/state.db or ./data/state.db)
M3TAL_STATE_DB=

# --- Plugins ---
# Additional plugin search directory scanned before the standard locations.
# The process working directory is never searched.
# M3TAL_PLUGINS_DIR=
# Set to 0/false/no/off to disable automatic startup of discovered plugins
# (they remain listed and can be started explicitly via the API/GUI).
# M3TAL_PLUGINS_AUTOSTART=

# --- WebSocket ---
# Comma-separated extra origins allowed to open /api/v2/ws/events besides
# same-origin requests (e.g. https://dashboard.example.com).
# M3TAL_WS_ALLOWED_ORIGINS=
