# --- Core Config ---
# Port the web dashboard will listen on (inside the Docker container).
# Accessible at http://localhost:8082 (or whatever port you map).
DASHBOARD_PORT=8082
DASHBOARD_EXPOSE_MODE=local


# Primary HTTP port for Traefik reverse proxy.
# NOTE: This must be a free port on the host. If you already run a web server
# on port 80, change this to an alternative like 8080.
HTTP_PORT=8080

# Directory where M3TAL stores runtime state (metrics, logs, etc.).
# Can be relative (./state) or absolute (/var/lib/m3tal/state).
STATE_DIR=./state

# Logging verbosity. Valid values: debug, info, warn, error.
LOG_LEVEL=info

# --- Auth ---
# Secret used to sign dashboard session cookies.
# Required. Generate a strong secret with: openssl rand -hex 32
# Example: DASHBOARD_SECRET=a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4
DASHBOARD_SECRET=change_me_immediately

# API Token for dashboard-to-backend authentication.
# Required. Generate a token with: openssl rand -hex 16
# Example: API_TOKEN=9f8e7d6c5b4a3c2d1e0f
API_TOKEN=change_me_api_token

# Initial admin password for the dashboard login page.
# Change this after first login using: ./m3tal dashpass admin <new-password>
ADMIN_PASSWORD=admin_pass

# --- Network ---
# The Docker network name used for inter-container communication.
# All M3TAL services are attached to this network.
NETWORK_NAME=m3tal

# Local IP address of the host machine.
# Used for internal cross-service routing. Defaults to 127.0.0.1 for local only.
# If other machines need access, set this to your LAN IP e.g. 192.168.1.100.
LOCAL_IP=127.0.0.1

# Root domain for Traefik service discovery.
# For local-only use: localhost
# For a homelab:      homelab.local
# For a real domain:  example.com
DOMAIN=localhost

# --- VPN Credentials (Optional) ---
# These are only needed if you run a VPN service inside the stack.
# Otherwise you can leave them as-is.
VPN_USER=user
VPN_PASSWORD=password

# --- Storage ---
# CRITICAL: Base path for all media and configuration data on the HOST.
# This directory MUST exist and be writable by the Docker daemon user.
# The path is mounted inside containers at /mnt.
#
# Examples:
#   Linux:   BASE_STORAGE_PATH=/home/youruser/m3tal-data
#   NAS:     BASE_STORAGE_PATH=/mnt/nfs-media
#   Local:   BASE_STORAGE_PATH=./data   (relative to the project root)
#
# ⚠️  If this directory does not exist or is not writable, containers
#     will start with an EMPTY /mnt — your data will be missing.
#     Run: mkdir -p /home/youruser/m3tal-data
BASE_STORAGE_PATH=./data

# Granular sub-paths (relative to BASE_STORAGE_PATH by default).
# These can be overridden independently if needed.
MEDIA_PATH=./data/media
CONFIG_PATH=./data/config
DOWNLOADS_PATH=./data/downloads